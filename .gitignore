# Generated at setup time - contains backups of overwritten files
backups/

# Retained eval runs (see docs/evals.md) - local measurement data, not config
evals/

# Personal git identity - lives in ~/.config/git/identity, never in this repo
gitconfig

# Machine-local credit store, if one is pointed inside the repo. It belongs
# outside, but a file that records what this machine has read is never config.
gate-credit.json
